TARIFF_IMPORT_CONFIG=
# 15min (default) publishes the RCE market's own quarter-hour prices;
# hourly averages each hour's four quarters first, matching how PGE
# settles prosument export credit.
RCE_EXPORT_GRANULARITY=15min
# zero (default) publishes 0.0 for a negative RCE price, matching
# net-billing paying nothing for it; raw publishes the true negative
# value (with no VAT bonus applied to it - the law doesn't define a
# bonus on a loss).
RCE_EXPORT_NEGATIVE_PRICES=zero
